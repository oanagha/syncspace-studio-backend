PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=syncspace_db
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_SECRET=change_this_in_production
JWT_EXPIRES=7d

# Public URL of your deployed frontend (optional — not needed for OTP reset flow)
# FRONTEND_URL=https://your-app.vercel.app

# SendGrid — required for password reset OTP emails
# 1. https://app.sendgrid.com/settings/api_keys — create key with Mail Send permission
# 2. https://app.sendgrid.com/settings/sender_auth — verify Single Sender OR Domain Authentication
# 3. For production deliverability, use Domain Authentication (not just Single Sender)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=you@yourdomain.com
APP_NAME=SyncSpace

# Optional: log reset links in terminal during local development only
# LOG_RESET_LINKS=false
